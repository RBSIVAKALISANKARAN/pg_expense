# Copy this file to .env for local development and fill in real values.
# Never commit .env or real credentials.

DJANGO_ENV=development
SECRET_KEY=replace-with-a-local-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=expense
DB_USER=postgres
DB_PASSWORD=replace-with-your-postgresql-password
DB_HOST=localhost
DB_PORT=5432

# SQL Playground safety limits. These are enforced by PostgreSQL for each
# playground execution through a READ ONLY transaction.
SQL_PLAYGROUND_TIMEOUT_MS=5000
SQL_PLAYGROUND_MAX_ROWS=500

# Production-only financial recovery override credentials.
# Generate unique values locally; never commit real credentials here.
POWER_OVERRIDE_USERNAME=replace-with-staff-only-username
POWER_OVERRIDE_PASSWORD=replace-with-a-strong-unique-password

# Production should use DJANGO_ENV=production, DEBUG=False, a persistent
# SECRET_KEY, explicit ALLOWED_HOSTS and HTTPS. The settings module enables
# secure defaults for HSTS, secure cookies, CSP, and nosniff in production.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_REFERRER_POLICY=same-origin
CSRF_TRUSTED_ORIGINS=
USE_PROXY_SSL_HEADER=False

# Production mailer settings.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=replace-with-smtp-username
EMAIL_HOST_PASSWORD=replace-with-smtp-password
EMAIL_TIMEOUT=10
