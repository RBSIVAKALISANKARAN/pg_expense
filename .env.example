# Copy this file to .env for local development and fill in real values.
# Never commit .env or real credentials.

SECRET_KEY=replace-with-a-local-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=expense
DB_USER=postgres
DB_PASSWORD=replace-with-your-postgresql-password
DB_HOST=localhost
DB_PORT=5432

# SQL Playground safety limits. These are enforced by PostgreSQL for each
# playground execution through a READ ONLY transaction.
SQL_PLAYGROUND_TIMEOUT_MS=5000
SQL_PLAYGROUND_MAX_ROWS=500

# Optional security settings
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
CSRF_TRUSTED_ORIGINS=
